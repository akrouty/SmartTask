<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Badge logo -->

    <!-- Title -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="100dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/logo_st"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SmartTask"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.9"
        android:text="Gérez vos tâches intelligemment"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- Features list -->
    <LinearLayout
        android:id="@+id/features"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- repeatable pill -->
        <TextView
            android:id="@+id/feat1"
            style="@style/TextAppearance.MaterialComponents.Body1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Organisez vos projets facilement"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_check_circle_24"
            android:drawablePadding="12dp"
            android:background="@drawable/bg_pill"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/feat2"
            style="@style/TextAppearance.MaterialComponents.Body1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Suivez vos tâches en temps réel"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_check_circle_24"
            android:drawablePadding="12dp"
            android:background="@drawable/bg_pill"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/feat3"
            style="@style/TextAppearance.MaterialComponents.Body1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Collaborez avec votre équipe"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_check_circle_24"
            android:drawablePadding="12dp"
            android:background="@drawable/bg_pill"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/feat4"
            style="@style/TextAppearance.MaterialComponents.Body1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Atteignez vos objectifs plus rapidement"
            android:textColor="@android:color/white"
            android:drawableStart="@drawable/ic_check_circle_24"
            android:drawablePadding="12dp"
            android:background="@drawable/bg_pill"/>
    </LinearLayout>

    <!-- Commencer button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCommencer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text="Commencer"
        android:backgroundTint="@android:color/white"
        android:textAllCaps="false"
        android:textColor="@color/blue_600"
        app:iconTint="@color/blue_600"
        app:rippleColor="@color/blue_100"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toTopOf="@+id/caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Caption -->
    <TextView
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rejoignez des milliers d’utilisateurs satisfaits"
        android:textColor="@android:color/white"
        android:alpha="0.8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Subtitle -->
</androidx.constraintlayout.widget.ConstraintLayout>
