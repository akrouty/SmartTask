<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:strokeColor="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@color/purple">

        <!-- Checkbox -->
         <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:buttonTint="@color/st_blue"
            app:layout_constraintBottom_toBottomOf="@id/tvTaskTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTaskTitle" />

        <!-- Date (pill à droite) -->
        <TextView
            android:id="@+id/tvTaskDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="15 Oct"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_pill"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Titre (✅ commence après le checkbox) -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="Finaliser le rapport mensuel"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/st_text_dark"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/cbDone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTaskDue" />

        <!-- Projet -->
        <TextView
            android:id="@+id/tvTaskProject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SmartTask – PFA 2025"
            android:textSize="13sp"
            android:textColor="@color/st_text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/tvTaskTitle"
            app:layout_constraintStart_toStartOf="@id/tvTaskTitle"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Meta : Priorité • Statut -->
        <LinearLayout
            android:id="@+id/rowPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvTaskProject"
            app:layout_constraintStart_toStartOf="@id/tvTaskTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Priorité pill -->
            <TextView
                android:id="@+id/tvPriorityPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_tag"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Moyenne"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <!-- Statut pill -->
            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_tag"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="En cours"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
